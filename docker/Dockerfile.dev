FROM node:22.11

# Accept build arguments for UID/GID with defaults
ARG UID=1000
ARG GID=1000

WORKDIR /app

# Create certificates directory for TLS
RUN mkdir -p /app/certs

COPY package*.json ./
RUN npm install

COPY . .

# Copy and run user creation script
COPY docker/create-user.sh /usr/local/bin/create-user.sh
RUN chmod +x /usr/local/bin/create-user.sh
RUN /usr/local/bin/create-user.sh $UID $GID
RUN chown -R appuser:appuser /app
USER appuser

CMD ["npm", "run", "dev"]