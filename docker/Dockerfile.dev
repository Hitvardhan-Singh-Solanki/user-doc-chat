FROM node:22.11

WORKDIR /app

# Create certificates directory for TLS
RUN mkdir -p /app/certs

COPY package*.json ./
RUN npm install

COPY . .

# Create non-root user for security (let Docker assign UID/GID)
RUN groupadd -r appuser && useradd -r -g appuser appuser
RUN chown -R appuser:appuser /app
USER appuser

CMD ["npm", "run", "dev"]