# Test Environment Configuration
# This file contains all required environment variables for testing
# Never commit actual secrets to version control

# Database Configuration (Test)
DATABASE_URL=postgresql://test:test@localhost:5432/test_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test_db
DB_USER=test
DB_PASSWORD=test
POSTGRES_PASSWORD=test

# Redis Configuration (Test)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=test

# JWT Configuration (Test)
JWT_SECRET=test_jwt_secret_for_testing_only_32_chars_minimum
JWT_EXPIRES_IN=3600
JWT_AUDIENCE=test-audience
JWT_ISSUER=test-issuer
JWT_MAX_AGE=86400

# External API Keys (Test)
HUGGINGFACE_HUB_TOKEN=test_token
PINECONE_API_KEY=test_pinecone_key
SERP_API_KEY=test_serp_key
BING_SEARCH_API_KEY=test_bing_key
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# Vector Database Configuration (Test)
PINECONE_ENVIRONMENT=test_environment
HUGGINGFACE_API_KEY=test_huggingface_key

# Storage Configuration (Test)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=test_access_key
MINIO_SECRET_KEY=test_secret_key
MINIO_USE_SSL=false
S3_BUCKET=test_bucket

# Application Configuration (Test)
NODE_ENV=test
PORT=3001
LOG_LEVEL=error

# Security Configuration (Test)
CORS_ORIGIN=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
MAX_REQUEST_SIZE=10485760

# Test-specific overrides
DEV_SSL_ALLOW=true
PG_SSL=false
