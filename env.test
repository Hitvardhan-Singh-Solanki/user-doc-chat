# Test Environment Configuration
# This file contains all required environment variables for testing
# Never commit actual secrets to version control

# Database Configuration (Test)
DATABASE_URL=postgresql://username:password@localhost:5432/test_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test_db
DB_USER=testuser
DB_PASSWORD=testpassword
POSTGRES_PASSWORD=testpassword

# Redis Configuration (Test)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=testredispassword

# JWT Configuration (Test)
JWT_SECRET=test_jwt_secret_for_testing_only_32_chars_minimum_secure_key_123456789
JWT_EXPIRES_IN=1h
JWT_AUDIENCE=test-audience
JWT_ISSUER=test-issuer
JWT_MAX_AGE=86400

# External API Keys (Test)
HUGGINGFACE_HUB_TOKEN=hf_test_token
PINECONE_API_KEY=pk_test_key
SERP_API_KEY=serp_test_key
BING_SEARCH_API_KEY=bing_test_key
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# AI/LLM Models (Test)
HUGGINGFACE_CHAT_MODEL=microsoft/DialoGPT-small
HUGGINGFACE_TOKENIZER_MODEL=bert-base-uncased
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_SUMMARY_MODEL=facebook/bart-large-cnn

# Vector Database Configuration (Test)
PINECONE_ENVIRONMENT=test-env
HUGGINGFACE_API_KEY=hf_test_api_key

# Storage Configuration (MinIO/S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=testminioaccesskey
MINIO_SECRET_KEY=testminiosecretkey
MINIO_USE_SSL=false
S3_BUCKET=test-bucket

# Application Configuration (Test)
NODE_ENV=test
PORT=3001
LOG_LEVEL=error

# Security Configuration (Test)
CORS_ORIGIN=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
MAX_REQUEST_SIZE=10485760

# Test-specific overrides
DEV_SSL_ALLOW=true
PG_SSL=false