# JWT Configuration (Test)
JWT_SECRET=REPLACE_WITH_32_CHAR_JWT_KEY_OR_LONGER
JWT_EXPIRES_IN=3600
JWT_AUDIENCE=CHANGE_ME
JWT_ISSUER=CHANGE_ME
JWT_MAX_AGE=86400

# External API Keys (Test)
