CORS_ORIGINS=http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
MAX_REQUEST_SIZE=10485760

# Test-specific overrides
DEV_SSL_ALLOW=true
PG_SSL=false
