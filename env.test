PINECONE_API_KEY=CHANGE_ME
SERP_API_KEY=CHANGE_ME
BING_SEARCH_API_KEY=CHANGE_ME
BING_SEARCH_ENDPOINT=CHANGE_ME

# Vector Database Configuration (Test)
PINECONE_ENVIRONMENT=CHANGE_ME
HUGGINGFACE_API_KEY=CHANGE_ME

# Storage Configuration (Test)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_USE_SSL=false
S3_BUCKET=CHANGE_ME

# Application Configuration (Test)
NODE_ENV=test
PORT=3001
LOG_LEVEL=error

# Security Configuration (Test)
