{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "schedule": ["before 6am on monday"],
  "timezone": "UTC",
  "labels": ["dependencies", "renovate"],
  "assignees": ["hitvardhan"],
  "reviewers": ["hitvardhan"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major"
    },
    {
      "matchPackagePatterns": ["eslint", "prettier", "vitest", "typescript"],
      "groupName": "dev dependencies",
      "groupSlug": "dev-deps"
    },
    {
      "matchPackagePatterns": ["express", "pg", "redis", "minio"],
      "groupName": "production dependencies",
      "groupSlug": "prod-deps"
    }
  ],
  "ignoreDeps": ["node"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "vulnerability"]
  }
}
