{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "timezone": "UTC",
  "labels": ["dependencies", "renovate"],
  "assignees": ["hitvardhan"],
  "reviewers": ["hitvardhan"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major"
    },
    {
      "groupName": "dev dependencies",
      "groupSlug": "dev-deps",
      "matchPackageNames": [
        "/eslint/",
        "/prettier/",
        "/vitest/",
        "/typescript/"
      ]
    },
    {
      "groupName": "production dependencies",
      "groupSlug": "prod-deps",
      "matchPackageNames": ["/express/", "/pg/", "/redis/", "/minio/"]
    }
  ],
  "ignoreDeps": ["node"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "vulnerability"]
  }
}
