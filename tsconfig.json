{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types"],
    "baseUrl": "./src",
    "paths": {
      "@config/*": ["config/*"],
      "@secrets": ["config/secrets.config"],
      "@config": ["config/app.config"],
      "@domains/*": ["domains/*"],
      "@auth/*": ["domains/auth/*"],
      "@chat/*": ["domains/chat/*"],
      "@files/*": ["domains/files/*"],
      "@health/*": ["domains/health/*"],
      "@vector/*": ["domains/vector/*"],
      "@infrastructure/*": ["infrastructure/*"],
      "@cache/*": ["infrastructure/cache/*"],
      "@database/*": ["infrastructure/database/*"],
      "@external/*": ["infrastructure/external-services/*"],
      "@ai/*": ["infrastructure/external-services/ai/*"],
      "@grpc/*": ["infrastructure/external-services/grpc/*"],
      "@search/*": ["infrastructure/external-services/search/*"],
      "@monitoring/*": ["infrastructure/monitoring/*"],
      "@queue/*": ["infrastructure/queue/*"],
      "@storage/*": ["infrastructure/storage/*"],
      "@shared/*": ["shared/*"],
      "@interfaces/*": ["shared/interfaces/*"],
      "@middleware/*": ["shared/middleware/*"],
      "@types/*": ["shared/types/*"],
      "@utils/*": ["shared/utils/*"],
      "@validators/*": ["shared/validators/*"],
      "@tests/*": ["tests/*"],
      "@fixtures/*": ["tests/fixtures/*"],
      "@mocks/*": ["tests/mocks/*"]
    }
  },
  "include": ["src", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
